# SimCorp API Configuration
# Copy this file to .env and fill in your values

# API Token for authentication (change from default in production!)
SIMCORP_API_TOKEN=dev-token-change-in-production

# LM Studio URL for AI inference
LM_STUDIO_URL=http://localhost:1234/v1

# Optional: Custom timeout for AI requests (seconds)
AI_REQUEST_TIMEOUT=60
